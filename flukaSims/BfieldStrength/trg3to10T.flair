# flair project file
Version: 300
Mode: fluka
md5: fa3826cff253e042728838cd2129e14b
Input:
#define trg_len 15
*********** Choose target material - default Nickel
!#define mat_tung
#define mat_inc
#if mat_tung
#define len 10
#elif mat_inc
#define len 17
#else
#define len 15
#endif
*********** radius is constant
#define rad 0.15
*********** Turn Bfield on/off
#define Bfield3
#define Bfield4
#define Bfield5
#define Bfield6
#define Bfield7
#define Bfield8
#define Bfield9
#define Bfield10
*********** This will discard : PHOTON, ELECTRON, POSITRON, NEUTRON, ANEUTRON
!#define discard
*********** This will turn on tracking and turn off scoring - defualt off
!#define track
TITLE
	target and source study
*Set the defaults for precision simulations
DEFAULTS PRECISIO
*Define the beam characteristics
BEAM PROTON -8.0
	@select=8
	scale=1
*Define the beam position
BEAMPOS ,,, -150
GEOBEGIN COMBNAME
SPH blkhole 0 0 0 1000
	@select=8
SPH void 0 0 0 800
	@select=8
TRC trg 0 0 =-(len/2) 0 0 $len $rad $rad
	@select=8
RCC solenoid,, 0 -100.0 0 0 200.0 70.0
	@select=8
RCC beamline,, 0 -199.5 0 0 599 30
	@select=8
XYP center 0
	@select=8
RCC wall 0 0 -200.0 0 0 600.0 80.0
	@select=8
RCC det1 0 0 100.1 0 0 5 29.99
	@select=8
RCC det2 0 0 200 0 0 5 29.99
	@select=8
RCC det3 0 0 300 0 0 5 29.99
	@select=9
RCC det4 0 0 394 0 0 4.9 29.99
	@select=8
END
REGION BLCKHOLE
	+blkhole -void
REGION VOID
	+void -wall
REGION BFIELD
	+solenoid -trg -beamline
	| +solenoid +beamline -trg
	| +beamline -solenoid -center -det1 -det2 -det3 -det4
REGION TRG
	+trg
REGION DRIVER
	+beamline +center -solenoid
REGION SOLENOID
	+wall -solenoid -beamline
REGION DET1
	+det1
REGION DET2
	+det2
REGION DET3
	+det3
REGION DET4
	+det4
END
GEOEND
MATERIAL GRAPHITE 6,, 1.7
MATERIAL CHROMIUM 24,, 7.18
*Inconel-600
MATERIAL Inconel_,,, 8.43
COMPOUND Inconel_ 15.0 CHROMIUM 9.0 IRON 76.0 NICKEL
MAT-PROP ,,, 78.0 GRAPHITE
MAT-PROP DPA-ENER 31.0,,, GRAPHITE
STERNHEI GRAPHITE 3.155 0.048 2.5387 0.20762 2.9532 0.14
ASSIGNMA , BLCKHOLE BLCKHOLE
ASSIGNMA , AIR VOID
ASSIGNMA , VACUUM DRIVER
ASSIGNMA , VACUUM BFIELD,,, 1
ASSIGNMA , AIR SOLENOID,,, 1
ASSIGNMA , VACUUM DET1,,, 1
ASSIGNMA , VACUUM DET2,,, 1
ASSIGNMA , VACUUM DET3,,, 1
ASSIGNMA , VACUUM DET4,,, 1
#if mat_inc
ASSIGNMA , Inconel_ TRG,,, 1
#else
ASSIGNMA , NICKEL TRG,,, 1
#endif
MGNCREAT FMGRID 300,,,,,,,,, 17 17 61 -80 -80 -200 80 80 400
#if Bfield3
#include ../../fieldmap/Bfield_flukaDatasets/B3L200R70_flukaGrid.inp
#elif Bfield4
#include ../../fieldmap/Bfield_flukaDatasets/B4L200R70_flukaGrid.inp
#elif Bfield5
#include ../../fieldmap/Bfield_flukaDatasets/B5L200R70_flukaGrid.inp
#elif Bfield6
#include ../../fieldmap/Bfield_flukaDatasets/B6L200R70_flukaGrid.inp
#elif Bfield7
#include ../../fieldmap/Bfield_flukaDatasets/B7L200R70_flukaGrid.inp
#elif Bfield8
#include ../../fieldmap/Bfield_flukaDatasets/B8L200R70_flukaGrid.inp
#elif Bfield9
#include ../../fieldmap/Bfield_flukaDatasets/B9L200R70_flukaGrid.inp
#elif Bfield10
#include ../../fieldmap/Bfield_flukaDatasets/B10L200R70_flukaGrid.inp
#endif
MGNFIELD FMGRID,,,, TRG
MGNFIELD FMGRID,,,, BFIELD
MGNFIELD FMGRID,,,, SOLENOID
MGNFIELD FMGRID,,,, DET1
MGNFIELD FMGRID,,,, DET2
MGNFIELD FMGRID,,,, DET3
MGNFIELD FMGRID,,,, DET4
#if discard
DISCARD , NEUTRON ANEUTRON PHOTON ELECTRON POSITRON
#endif
#if track
USERDUMP dump 100 31 0
#else
USERDUMP score 100 32 0 1
!USERWEIG ,,, 3
*## Score hadrons that are produced in the target
!USRYIELD pip_prod 201 PION+ -33 -1 -2 0.01 10 0 60 100 0 2803
!USRYIELD pin_prod 201 PION- -33 -1 -2 0.01 10 0 60 100 0 2803
!USRYIELD mup_prod 201 MUON+ -33 -1 -2 0.01 10 0 60 100 0 2803
!USRYIELD mun_prod 201 MUON- -33 -1 -2 0.01 10 0 60 100 0 2803
*## Score hadrons that escape the target
!USRBDX escSco 1 ALL-PART -35 TRG BFIELD 1 15 0 60
!USRBDX det1in 1 ALL-PART -35 DET1 BFIELD 1 15 0 60
!USRBDX det1out 1 ALL-PART -35 DET1 SOLENOID 1 15 0 60
!USRBDX aro_mup 1 MUON+ -35 TRG VOID 1 10 0 60
!USRBDX aro_mun 1 MUON- -35 TRG VOID 1 10 0 60
!USRBDX aro_piz 1 PIZERO -34 TRG TRG_ARO 1 10 0 60
!USRBIN bin 10 PION+ -21 70 70 100 -70 -70 -100 140 140 200
#endif
*..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*Set the random number seed
RANDOMIZ , 1.0
#if track
*Set the number of primary histories to be simulated in the run
START , 100
#else
*Set the number of primary histories to be simulated in the run
START , 100000
#endif
STOP
EndInput

Page: Run
plotengine: Gnuplot
