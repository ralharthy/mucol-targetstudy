# flair project file
Version: 300
Mode: fluka
md5: 2e7638b925a9a66d71eea73dde0eace3
Input:
#define Bfield
#define Bfield03
#define Bfield04
#define Bfield05
#define Bfield06
#define Bfield07
#define Bfield08
#define Bfield09
#define Bfield10
TITLE
	Capture System
*Set the defaults for precision simulations
DEFAULTS PRECISIO
*Define the beam characteristics
BEAM PROTON -8.0
	@select=8
	scale=3.5
*Define the beam position
BEAMPOS ,,, -150
GEOBEGIN COMBNAME
SPH blkbody 0 0 0 1250
	@select=8
SPH void 0 0 0 700.0
	@select=8
ZEC out_sol 0 0 80.0 80
ZEC in_sol 0 0 70.0 70
ZEC beamline 0 0 30.0 30
XYP wall1 -200.0
XYP wall2 -100.0
XYP wall3 100.0
XYP wall4 400.0
XYP det2 200.0
XYP det3 300.0
RCC target 0 0 -7.5 0 0 15 0.15
	@select=8
END
REGION BLKBODY
	+blkbody -void
REGION VOID
	+void +wall1
	| +void -wall4
	| +void -out_sol
REGION OUT
	+out_sol +wall4 -in_sol -wall1
	| +in_sol +wall2 -beamline -wall1
	| +in_sol +wall4 -beamline -wall3
REGION DRIVER
	+beamline +wall2 -wall1
REGION SOLENOID
	+in_sol +wall3 -wall2 -target
REGION BEAML1
	+beamline +det2 -wall3
REGION BEAML2
	+beamline +det3 -det2
REGION BEAML3
	+beamline +wall4 -det3
REGION TRG
	+target
END
GEOEND
MATERIAL CHROMIUM 24,, 7.18
*Inconel-600
MATERIAL Inconel_,,, 8.43
COMPOUND Inconel_ 15.0 CHROMIUM 9.0 IRON 76.0 NICKEL
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , AIR VOID
ASSIGNMA , AIR OUT,,, 1
ASSIGNMA , VACUUM DRIVER,,, 1
ASSIGNMA , VACUUM SOLENOID,,, 1
ASSIGNMA , VACUUM BEAML1,,, 1
ASSIGNMA , VACUUM BEAML2,,, 1
ASSIGNMA , VACUUM BEAML3,,, 1
ASSIGNMA , Inconel_ TRG,,, 1
#if Bfield
MGNCREAT FMGRID 300,,,,,,,,, 17 17 61 -80 -80 -200 80 80 400
#if Bfield03
#include ../../fieldmap/Bfield_flukaDatasets/B3L150R70_flukaGrid.inp
#elif Bfield04
#include ../../fieldmap/Bfield_flukaDatasets/B4L150R70_flukaGrid.inp
#elif Bfield05
#include ../../fieldmap/Bfield_flukaDatasets/B5L150R70_flukaGrid.inp
#elif Bfield06
#include ../../fieldmap/Bfield_flukaDatasets/B6L150R70_flukaGrid.inp
#elif Bfield07
#include ../../fieldmap/Bfield_flukaDatasets/B7L150R70_flukaGrid.inp
#elif Bfield08
#include ../../fieldmap/Bfield_flukaDatasets/B8L150R70_flukaGrid.inp
#elif Bfield09
#include ../../fieldmap/Bfield_flukaDatasets/B9L150R70_flukaGrid.inp
#elif Bfield10
#include ../../fieldmap/Bfield_flukaDatasets/B10L150R70_flukaGrid.inp
#endif
MGNFIELD FMGRID,,,, OUT
MGNFIELD FMGRID,,,, DRIVER
MGNFIELD FMGRID,,,, SOLENOID
MGNFIELD FMGRID,,,, BEAML1
MGNFIELD FMGRID,,,, BEAML2
MGNFIELD FMGRID,,,, BEAML3
MGNFIELD FMGRID,,,, OUT
#else
MGNFIELD ,,,,,, 0
#endif
USERDUMP dump 100 21 0 1
*..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
*Set the random number seed
RANDOMIZ , 1.0
*Set the number of primary histories to be simulated in the run
START
STOP
EndInput

