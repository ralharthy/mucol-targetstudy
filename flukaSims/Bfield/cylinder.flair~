TITLE
	Capture System
*Set the defaults for precision simulations
DEFAULTS PRECISIO
*Define the beam characteristics
BEAM PROTON -8.0
	@select=8
	scale=3.5
*Define the beam position
BEAMPOS ,,, -150
GEOBEGIN COMBNAME
SPH blkbody 0 0 0 1250
	@select=8
SPH void 0 0 0 700.0
	@select=8
ZEC out_sol 0 0 80.0 80
ZEC in_sol 0 0 70.0 70
ZEC beamline 0 0 30.0 30
XYP wall1 -200.0
XYP wall2 -75
XYP wall3 75
XYP wall4 375
	@select=1
XYP det2 175
XYP det3 275
RCC target 0 0 -7.5 0 0 15 0.15
	@select=8
END
REGION BLKBODY
	+blkbody -void
REGION VOID
	+void +wall1
	| +void -wall4
	| +void -out_sol
