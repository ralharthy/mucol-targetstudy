# The "default" physics list is QGSP_BERT
physics QGSP_BERT

# Define a solenoid coil for capturing and guiding muons
coil MuonCaptureCoilL150 innerRadius=700 outerRadius=750 length=1500 nSheets=2000 material=Cu
coil World innerRadius=1000 outerRadius=1100 length=20000 nSheets=1000 material=Cu

# Generate a solenoid field using the coil
# (A)   200cm   | 150cm    | 
# 3T  = 58.8    | 66.3     |
# 4T  = 78.5    | 88.2     |
# 5T  = 98.68   | 110      | 
# 6T  = 117.9   | 132.2    |
# 7T  = 137.5   | 154.3    |
# 8T  = 157.2   | 177      |
# 9T  = 176.8   | 199      |
# 10T = 196.4   | 221      |
solenoid MuonSolenoid coilName=MuonCaptureCoilL150 current=221 color=0,1,1,0.4
solenoid WorldSolenoid coilName=World current=0 color=0,1,0.5,0.7

# Place the solenoid over the tungsten target
place MuonSolenoid z=0
place WorldSolenoid z=0

# Print the fieldmap
# Uncomment the printfield line that you wnat to use
# Naming convention: B*L*R*_mapType.txt (* in cm)
printfield type=grid file=Bfield_g4blDatasets/B10L150R70_fmGrid.txt X0=-800 Y0=-800 Z0=-2000 nX=17 nY=17 nZ=61 dX=100 dY=100 dZ=100
printfield type=cylinder file=Bfield_g4blDatasets/B10L150R70_fmCylinder.txt Z0=-4000 nR=5 dR=5 nZ=1601 dZ=5
