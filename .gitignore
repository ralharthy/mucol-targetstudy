# ignore all data "txt", "dat" and "flair" files upon pushing to github
*.txt
*.dat
*.parquet
fieldmap/Bfield_flukaDatasets/*.flair
fieldmap/Bfield_flukaDatasets/*~

# ignore the virtual environment folder
mucol-env/

# ignore __pycheck__ folder
# you can safely delete this folder if it exists, it is generated by Python when running the code and contains cached bytecode files.
__pycache__/
*.pyc

# ignore .ipynb_checkpoints folder
.ipynb_checkpoints/

# ignore personal notes files
myNotes.txt

# ignore FLUKA's jargon files
flukaSims/BfieldStrength/*/

# Keep exe/ and exe2/
!flukaSims/BfieldStrength/exe/
!flukaSims/BfieldStrength/exe2/

# Ignore everything inside them
flukaSims/BfieldStrength/exe/*
flukaSims/BfieldStrength/exe2/*

# But keep .f files
!flukaSims/BfieldStrength/exe/*.f
!flukaSims/BfieldStrength/exe/Makefile
!flukaSims/BfieldStrength/exe2/*.f
!flukaSims/BfieldStrength/exe2/Makefile
